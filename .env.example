# Copy to .env next to docker-compose.yml.

# Where the app repos are, relative to this folder. Defaults: cloned inside it.
# For sibling checkouts (projects/{infra,signestate,be}) use ../signestate and ../be.
# FE_DIR=./signestate
# BE_DIR=./signastate-be

# Domain Traefik serves and requests the Let's Encrypt certificate for. Its DNS
# A/AAAA record must point at this server, with ports 80 and 443 open.
# With `localhost`, no certificate can be issued and Traefik falls back to a
# self-signed one (browser warning).
APP_DOMAIN=localhost
# Domain of the FastAPI backend (BE_DIR). Same DNS and port requirements as
# APP_DOMAIN. The frontend still calls the json-server mock at ${APP_DOMAIN}/api.
API_DOMAIN=api-qa.elitekosova.com
# Contact address for Let's Encrypt (optional).
ACME_EMAIL=
# Uncomment to test against Let's Encrypt staging (untrusted certs, generous
# rate limits). Before switching back to production, drop the staging certs:
# `make down && docker volume rm signestate_letsencrypt`.
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Traefik dashboard, bound to 127.0.0.1 only.
DASHBOARD_PORT=8080

# Baked into the frontend bundle at image build time — rebuild after changing
# (make rebuild-fe). See .env.example in the signestate repo for details.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# ── Backend, see .env.example in the signastate-be repo for every setting ──
# local | dev | stage | prod. prod refuses the default docs password.
BE_ENV=stage
# Required. Postgres only reads it when its volume is first created: changing
# it later needs an ALTER USER inside Postgres too, or the backend can't log in.
DB_PASSWORD=
# Postgres is also public on ${DB_DOMAIN}:${DB_PUBLIC_PORT}, TLS only, so DB_PASSWORD
# is all that keeps strangers out: make it long. Open the port in the server's
# firewall too. DB_DOMAIN defaults to API_DOMAIN, whose DNS record and cert exist.
#   psql "host=api-qa.elitekosova.com dbname=signestate user=postgres sslmode=verify-full sslrootcert=system"
# DB_DOMAIN=
# DB_PUBLIC_PORT=5432
# Comma-separated CIDRs allowed to connect. Default: everyone. Example: 203.0.113.7/32
# DB_ALLOWED_IPS=0.0.0.0/0,::/0
# Required. Login for https://${API_DOMAIN}/docs and /redoc.
DOCS_USERNAME=signestate
DOCS_PASSWORD=
# JSON list of origins allowed to call the backend. Defaults to ["https://${APP_DOMAIN}"].
# Setting it replaces that default, so keep the app domain in the list. Example that
# also lets a local Vite dev server call it:
# CORS_ORIGINS='["https://qa.elitekosova.com","http://localhost:5173"]'
