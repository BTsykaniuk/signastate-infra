# Copy to .env next to docker-compose.yml.

# Domain Traefik serves and requests the Let's Encrypt certificate for. Its DNS
# A/AAAA record must point at this server, with ports 80 and 443 open.
# With `localhost`, no certificate can be issued and Traefik falls back to a
# self-signed one (browser warning).
APP_DOMAIN=localhost
# Domain the backend (api) gets on its own, next to ${APP_DOMAIN}/api, which
# the frontend still calls. Same DNS and port requirements as APP_DOMAIN.
API_DOMAIN=api-qa.elitekosova.com
# Contact address for Let's Encrypt (optional).
ACME_EMAIL=
# Uncomment to test against Let's Encrypt staging (untrusted certs, generous
# rate limits). Before switching back to production, drop the staging certs:
# `make down && docker volume rm signestate_letsencrypt`.
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Traefik dashboard, bound to 127.0.0.1 only.
DASHBOARD_PORT=8080

# Baked into the frontend bundle at image build time — rebuild after changing
# (make rebuild-fe). See signestate/.env.example for details.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
