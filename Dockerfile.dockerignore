# Named after the Dockerfile, so Docker reads it in place of a .dockerignore
# at the root of the build context (the parent folder).
**/node_modules
**/dist
**/dist-ssr
**/.git
**/.env
**/.env.*
!**/.env.example
signestate/public/uploads/*
!signestate/public/uploads/.gitkeep
**/.scratch
**/.vscode
**/.idea
**/.DS_Store
**/*.log
# Of the parent folder, only ./signestate and nginx.conf go into the build.
be
.claude
infra/*
!infra/nginx.conf
